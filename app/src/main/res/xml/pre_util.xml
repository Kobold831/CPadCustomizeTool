<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_util_category_function">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_start_settings"
            android:title="@string/pre_other_title_settings" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_start_dev_settings"
            android:title="@string/pre_other_title_development" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_start_ui_adjustment"
            android:title="@string/pre_other_title_adjustment" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_web_view"
            android:summary="@string/pre_util_sum_web_view"
            android:title="@string/pre_util_title_web_view" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_launch_app"
            android:summary="@string/pre_util_sum_launch_app"
            android:title="@string/pre_util_title_launch_app" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_util_re-enable_system-apps"
            android:title="@string/pre_util_title_reenable_system_apps"
            android:summary="@string/pre_util_sum_reenable_system_apps" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_util_category_info">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_start_device_info"
            android:title="@string/activity_device_info" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
