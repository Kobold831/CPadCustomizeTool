<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="pre_notice"
        android:icon="@drawable/info_24px"
        android:title="" />

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:key="1"
        android:title="@string/pre_main_category_system_ui">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_dcha_state"
            android:title="@string/pre_main_title_system_ui" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_keep_dcha_state"
            android:title="@string/pre_main_title_keep_system_ui" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_navigation"
            android:title="@string/pre_main_title_navigation_bar" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_keep_navigation"
            android:title="@string/pre_main_title_keep_navigation_bar" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:key="2"
        android:title="@string/pre_main_category_system">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_owner_install_unknown_source"
            android:title="@string/pre_main_title_owner_install_unknown_source"
            android:summary="@string/pre_main_sum_unknown_source_disallowed" />

        <Preference
            app:selectable="false"
            android:key="pre_install_unknown_source_info"
            android:icon="@drawable/info_24px"
            android:summary="@string/pre_main_sum_install_unknown_source_info" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_main_request_install_packages"
            android:title="@string/pre_main_title_request_install_packages"
            android:summary="@string/pre_main_sum_request_install_packages" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_unk_src"
            android:title="@string/pre_main_title_non_market" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_keep_unk_src"
            android:title="@string/pre_main_title_keep_non_market" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_adb"
            android:title="@string/pre_main_title_usb_debug" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_keep_adb"
            android:title="@string/pre_main_title_keep_usb_debug" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_settings"
            android:title="@string/pre_main_title_other_settings"
            android:summary="@string/pre_main_sum_other" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:key="category_other"
        android:title="@string/pre_main_category_other_settings">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_enable_dcha_service"
            android:title="@string/pre_main_title_use_dcha" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_dcha_function"
            android:title="@string/pre_main_title_dcha_function"
            android:summary="@string/pre_main_sum_dcha_function" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_main_category_device_admin">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_device_owner_fn"
            android:title="@string/pre_main_title_device_owner"
            android:summary="@string/pre_main_sum_device_owner" />

        <Preference
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false"
            android:key="pre_edit_admin"
            android:title="@string/pre_main_title_edit_admin" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_device_admin"
            android:title="@string/pre_main_title_device_admin"
            android:summary="@string/pre_main_sum_device_admin" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:key="pre_cat_assist"
        android:title="@string/pre_main_category_assist">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_function"
            android:title="@string/pre_main_title_app_function"
            android:summary="@string/pre_main_sum_app_function" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_util"
            android:title="@string/pre_main_title_util"
            android:summary="@string/pre_main_sum_util" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_get_app"
            android:title="@string/pre_main_title_get_app"
            android:summary="@string/pre_main_sum_get_app" />

    </PreferenceCategory>

</PreferenceScreen>
