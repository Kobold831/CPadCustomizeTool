<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_app_category_start_settings">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_app_update_check"
            android:title="@string/pre_app_title_update_check" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_app_simple_mode"
            android:title="@string/pre_app_title_simple_mode"
            android:summary="@string/pre_app_sum_simple_mode" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_app_category_settings">

        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            android:key="pre_app_normal_env"
            android:title="@string/pre_app_title_normal_env" />

        <Preference
            app:selectable="false"
            android:key="pre_install_unknown_source_info"
            android:icon="@drawable/ic_info_outline_24"
            android:summary="@string/pre_app_sum_normal_env" />

        <SwitchPreferenceCompat
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"
            android:key="pre_app_use_dcha"
            android:summary="@string/pre_app_sum_dcha"
            android:title="@string/pre_app_title_dcha" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_clear_cache"
            android:summary="@string/pre_app_sum_clear_cache"
            android:title="@string/pre_app_title_clear_cache" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_clear_data"
            android:summary="@string/pre_app_sum_clear_data"
            android:title="@string/pre_app_title_clear_data" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_app_category_update">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_update_mode"
            android:summary="@string/pre_app_sum_update_mode"
            android:title="@string/pre_app_title_update" />

    </PreferenceCategory>

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_app_category_log">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_crash_log"
            android:summary="@string/pre_app_sum_crash_log"
            android:title="@string/pre_app_title_crash_history" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_del_crash_log"
            android:title="@string/pre_app_title_delete_crash_history" />

    </PreferenceCategory>

    <PreferenceCategory
        app:isPreferenceVisible="false"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:key="pre_app_category_debug"
        android:title="@string/pre_app_category_debug">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_app_debug_restriction"
            android:title="@string/pre_app_title_debug_restriction" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_debug_force_crash"
            android:title="@string/pre_app_title_debug_force_crash" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_app_debug_device"
            android:title="@string/pre_app_title_debug_device" />

    </PreferenceCategory>

</PreferenceScreen>
