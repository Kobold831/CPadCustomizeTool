<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:selectable="false"
        android:key="pre_owner_now_set_own_pkg"
        android:icon="@drawable/info_24px" />

    <PreferenceCategory
        android:title="@string/pre_owner_category_uninstall"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_owner_uninstall_block"
            android:summary="@string/pre_owner_sum_uninstall_block"
            android:title="@string/pre_owner_title_uninstall_block" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pre_owner_category_permission"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_owner_permission_frc"
            android:summary="@string/pre_owner_sum_permission_forced"
            android:title="@string/pre_owner_title_permission" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pre_owner_category_install"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_owner_session_install"
            android:summary="@string/pre_owner_sum_silent_install"
            android:title="@string/pre_owner_title_silent_install" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_owner_abandon_session"
            android:summary="@string/pre_owner_sum_abandon_session"
            android:title="@string/pre_owner_title_abandon_session" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pre_owner_category_device_owner"
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false">

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_owner_clr_dev_own"
            android:title="@string/pre_owner_title_device_owner" />

    </PreferenceCategory>

</PreferenceScreen>
