<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:allowDividerAbove="false"
        app:iconSpaceReserved="false"
        android:title="@string/pre_other_category_display">

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pre_other_ui_mode_night"
            android:title="@string/pre_other_title_dark_mode" />

        <Preference
            app:selectable="false"
            android:icon="@drawable/info_24px"
            android:summary="@string/pre_other_sum_dark_mode" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pre_other_screen_off_time"
            android:title="@string/pre_other_title_screen_off_time"
            android:summary="@string/pre_other_sum_screen_off_time" />

        <Preference
            app:selectable="false"
            android:icon="@drawable/info_24px"
            android:summary="@string/pre_other_sum_screen_off_time_warning" />


        <Preference
            app:selectable="false"
            android:icon="@drawable/info_24px"
            android:summary="@string/pre_other_sum_write_secure_settings" />

    </PreferenceCategory>

</PreferenceScreen>
