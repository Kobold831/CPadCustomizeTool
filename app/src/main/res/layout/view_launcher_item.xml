<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="false"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/launcher_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/launcher_item_spacing"
        android:clickable="false"
        android:focusable="false"
        android:paddingTop="@dimen/launcher_item_spacing" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/launcher_image"
        android:layout_width="@dimen/launcher_item_icon_size"
        android:layout_height="@dimen/launcher_item_icon_size"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/launcher_item_spacing_small"
        android:layout_marginBottom="@dimen/launcher_item_spacing_small"
        android:contentDescription="@string/img_content_description" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/launcher_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/launcher_item_text_margin_start"
        android:textSize="@dimen/launcher_item_text_size" />

</LinearLayout>
