<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/launch_app_image"
        android:layout_width="@dimen/launch_app_item_icon_size"
        android:layout_height="@dimen/launch_app_item_icon_size"
        android:layout_marginStart="@dimen/launch_app_item_spacing"
        android:layout_marginTop="@dimen/launch_app_item_spacing"
        android:layout_marginBottom="@dimen/launch_app_item_spacing"
        android:contentDescription="@string/img_content_description" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyApp.TextView"
            android:id="@+id/launch_app_text_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/launch_app_item_text_margin_start"
            android:textSize="@dimen/launch_app_item_text_size" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/launch_app_text_pack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/launch_app_item_text_margin_start" />

    </LinearLayout>

</LinearLayout>
