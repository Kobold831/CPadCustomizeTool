<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_spacing"
            android:gravity="center"
            android:text="@string/wel_title"
            android:textColor="@color/textColor"
            android:textSize="@dimen/welcome_button_text_size" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/welcome_spacing"
            android:layout_marginHorizontal="@dimen/welcome_margin_horizontal"
            android:gravity="start"
            android:text="@string/wel_description"
            android:textColor="@color/textColor" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/welcome_margin_horizontal"
            android:layout_marginTop="@dimen/welcome_spacing"
            android:orientation="vertical"
            android:background="@drawable/shape_rounded_corners">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/wel_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/welcome_spacing"
                android:textColor="@color/textColor"
                android:textSize="@dimen/welcome_text_size" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/welcome_margin_horizontal"
        android:layout_marginTop="@dimen/welcome_spacing"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            style="?welcomeButtonDoneStyle"
            android:id="@+id/wel_no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/welcome_spacing"
            android:gravity="center"
            android:text="@string/wel_disagree"
            android:textSize="@dimen/welcome_button_text_size"
            android:textColor="@color/welcomeButtonTextColor" />

        <androidx.appcompat.widget.AppCompatButton
            style="?welcomeButtonDoneStyle"
            android:id="@+id/wel_yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/welcome_spacing"
            android:gravity="center"
            android:text="@string/wel_agree"
            android:textSize="@dimen/welcome_button_text_size"
            android:textColor="@color/welcomeButtonTextColor" />

    </LinearLayout>

</LinearLayout>
