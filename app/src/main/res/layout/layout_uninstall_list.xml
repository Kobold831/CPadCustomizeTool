<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/uninstall_list_spacing"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/un_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/divider_transparent"
            android:dividerHeight="@dimen/uninstall_list_spacing" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/un_button_disable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/uninstall_list_button_margin_vertical"
            android:layout_marginEnd="@dimen/uninstall_list_button_gap"
            android:text="@string/layout_un_list_button_1" />

        <com.google.android.material.button.MaterialButton
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/un_button_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginVertical="@dimen/uninstall_list_button_margin_vertical"
            android:layout_marginStart="@dimen/uninstall_list_button_gap"
            android:text="@string/layout_un_list_button_2" />

    </LinearLayout>

</LinearLayout>
