<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/splash_margin_horizontal"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/splash_spacing"
                android:text="@string/crash_message"
                android:textColor="@android:color/holo_red_light"
                android:textSize="@dimen/splash_title_text_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/splash_spacing">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/MyApp.TextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/crash_try_following"
                    android:textSize="@dimen/splash_text_size"/>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/splash_spacing"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/splash_spacing">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text="@string/crash_clear_data_title"
                        android:textSize="@dimen/splash_text_size" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_clear_data_message"
                        android:textSize="@dimen/splash_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/act_splash_btn_clear_app_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/crash_clear_data_button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/splash_spacing"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/splash_spacing"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text="@string/crash_other_solution_title"
                        android:textSize="@dimen/splash_text_size" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_other_solution_message"
                        android:textSize="@dimen/splash_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/act_splash_btn_open_web"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/crash_open_web_button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/splash_spacing"
                android:focusable="true"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/splash_spacing"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text="@string/crash_send_crash_title"
                        android:textSize="@dimen/splash_text_size" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_send_crash_message"
                        android:textSize="@dimen/splash_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/act_splash_btn_send_crash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/crash_send_crash_button" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/MyApp.TextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_open_history_message"
                        android:textSize="@dimen/splash_text_size" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/act_splash_btn_open_crash"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/crash_open_history_button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/splash_spacing">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyApp.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="@string/crash_scroll_notice" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crash_back_main_message"
            android:textColor="@android:color/holo_red_light"
            android:textSize="@dimen/splash_text_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/act_splash_btn_main"
            android:layout_width="match_parent"
            android:layout_height="@dimen/splash_button_height"
            android:text="@string/crash_back_main_button"
            android:autoSizeTextType="uniform" />

    </LinearLayout>

</LinearLayout>
