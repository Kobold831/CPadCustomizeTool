<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:layout_marginVertical="@dimen/simple_function_spacing_small"
        android:text="@string/layout_simple_function_system_ui"
        android:textSize="@dimen/simple_function_header_text_size"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lo_simple_function_card_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:layout_marginBottom="@dimen/simple_function_spacing"
        android:focusable="true"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/simple_function_spacing"
            android:layout_marginVertical="@dimen/simple_function_spacing"
            android:gravity="center"
            android:text="@string/activity_normal"
            android:textSize="@dimen/simple_function_card_text_size"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lo_simple_function_card_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:focusable="true"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/simple_function_spacing"
            android:layout_marginVertical="@dimen/simple_function_spacing"
            android:gravity="center"
            android:text="@string/layout_simple_function_study_mode"
            android:textSize="@dimen/simple_function_card_text_size"/>

    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:layout_marginVertical="@dimen/simple_function_spacing_small"
        android:text="@string/layout_simple_function_navigation_bar"
        android:textSize="@dimen/simple_function_header_text_size"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lo_simple_function_card_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:layout_marginBottom="@dimen/simple_function_spacing"
        android:focusable="true"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/simple_function_spacing"
            android:layout_marginVertical="@dimen/simple_function_spacing"
            android:gravity="center"
            android:text="@string/layout_simple_function_show"
            android:textSize="@dimen/simple_function_card_text_size" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lo_simple_function_card_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/simple_function_spacing"
        android:layout_marginBottom="@dimen/simple_function_spacing_small"
        android:focusable="true"
        android:clickable="true">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/simple_function_spacing"
            android:layout_marginVertical="@dimen/simple_function_spacing"
            android:gravity="center"
            android:text="@string/layout_simple_function_hide"
            android:textSize="@dimen/simple_function_card_text_size"/>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
