<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/v_resolution_linearlayout_any"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/resolution_margin"
        android:visibility="visible">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="@string/view_resolution_text_width"
            android:inputType="number"
            android:maxLength="4" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/view_resolution_text_x" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="@string/view_resolution_text_height"
            android:inputType="number"
            android:maxLength="4" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/v_resolution_linearlayout_benesse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/resolution_margin"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/MyApp.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_resolution_text_permission" />

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/xga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_resolution_rb_1024" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/wxga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_resolution_rb_1280" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/wuxga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_resolution_rb_1920" />

        </RadioGroup>

    </LinearLayout>

</LinearLayout>
